# Copy to .env and fill in. Never commit .env.

# Always required
APP_SECRET_KEY=replace-with-64-random-hex-characters
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///./kpi.db
SCHEDULER_ENABLED=true
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
ALLOW_LIVE_EMAIL=false

# QuickBooks (from the Intuit developer app)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8000/qbo/callback
QBO_ENVIRONMENT=sandbox

# LIVE email only
POSTMARK_SERVER_TOKEN=
REPORT_FROM_EMAIL=
REPORT_FROM_NAME=
OPERATOR_EMAIL=
SENDER_DOMAIN_VERIFIED=false
